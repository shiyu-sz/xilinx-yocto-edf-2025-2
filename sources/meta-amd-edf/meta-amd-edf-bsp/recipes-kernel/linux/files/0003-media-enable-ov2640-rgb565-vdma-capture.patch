From: Local EDF BSP <edf-bsp@localhost>
Subject: [PATCH] media: enable OV2640 RGB565 VDMA capture on the custom Zynq

Port the 800x480 sensor window and RGB565 defaults from acz702 commit
75bb9a494b7197bd5d59fb1fe63b63da1864803f to the Linux 6.12 subdev API.
The fixed PL pipeline unpacks big-endian DVP bytes into little-endian
RGB565 memory pixels; do not use the old YUV capture defaults.

Initialize the multi-planar height, buffer count and DMA crop rectangle,
and return the buffer count when negotiating multi-planar formats.

Hold the optional PL reset-source clock while the sensor is bound. In this
XSA, dynclk LOCKED_O releases both Camera_Data_0 and the 24 MHz xvclk MMCM;
capture must not depend on a connected HDMI monitor to enable this clock.

These defaults apply only to the custom machine that carries this patch.

Upstream-Status: Inappropriate [board-specific integration]

---
diff --git a/drivers/media/i2c/ov2640.c b/drivers/media/i2c/ov2640.c
--- a/drivers/media/i2c/ov2640.c
+++ b/drivers/media/i2c/ov2640.c
@@ -310,6 +310,9 @@
 /*
  * Registers settings
  */
+
+#define OV2640_800X480_WIDTH  800
+#define OV2640_800X480_HEIGHT 480
 
 #define ENDMARKER { 0xff, 0xff }
 
@@ -549,6 +552,40 @@
 	ENDMARKER,
 };
 
+static const struct regval_list ov2640_800x480_regs[] = {
+	{ BANK_SEL, BANK_SEL_SENS },
+	{ COM7, COM7_RES_SVGA },
+	{ HSTART, 0x11 },
+	{ HEND, 0x43 },
+	{ VSTART, 0x00 },
+	{ VEND, 0x4b },
+	{ REG32, 0x09 },
+	{ 0x37, 0xc0 },
+	{ 0x3d, 0x38 },
+	{ BANK_SEL, BANK_SEL_DSP },
+	{ HSIZE8, HSIZE8_SET(SVGA_WIDTH) },
+	{ VSIZE8, VSIZE8_SET(SVGA_HEIGHT) },
+	{ SIZEL, 0x00 },
+	{ CTRL2, CTRL2_DCW_EN | CTRL2_SDE_EN | CTRL2_UV_ADJ_EN |
+		 CTRL2_UV_AVG_EN | CTRL2_CMX_EN },
+	{ CTRLI, 0x00 },
+	{ HSIZE, HSIZE_SET(OV2640_800X480_WIDTH) },
+	{ VSIZE, VSIZE_SET(OV2640_800X480_HEIGHT) },
+	{ XOFFL, XOFFL_SET(0) },
+	{ YOFFL, YOFFL_SET((SVGA_HEIGHT - OV2640_800X480_HEIGHT) / 2) },
+	{ VHYX, VHYX_HSIZE_SET(OV2640_800X480_WIDTH) |
+		 VHYX_VSIZE_SET(OV2640_800X480_HEIGHT) |
+		 VHYX_XOFF_SET(0) |
+		 VHYX_YOFF_SET((SVGA_HEIGHT - OV2640_800X480_HEIGHT) / 2) },
+	{ ZMOW, ZMOW_OUTW_SET(OV2640_800X480_WIDTH) },
+	{ ZMOH, ZMOH_OUTH_SET(OV2640_800X480_HEIGHT) },
+	{ ZMHH, ZMHH_OUTW_SET(OV2640_800X480_WIDTH) |
+		 ZMHH_OUTH_SET(OV2640_800X480_HEIGHT) },
+	{ R_DVP_SP, R_DVP_SP_AUTO_MODE | 0x02 },
+	{ RESET, 0x00 },
+	ENDMARKER,
+};
+
 static const struct regval_list ov2640_xga_regs[] = {
 	PER_SIZE_REG_SEQ(XGA_WIDTH, XGA_HEIGHT, 0, 0, 2),
 	{ CTRLI,    0x00},
@@ -577,6 +614,8 @@
 	OV2640_SIZE("QVGA", QVGA_WIDTH, QVGA_HEIGHT, ov2640_qvga_regs),
 	OV2640_SIZE("CIF", CIF_WIDTH, CIF_HEIGHT, ov2640_cif_regs),
 	OV2640_SIZE("VGA", VGA_WIDTH, VGA_HEIGHT, ov2640_vga_regs),
+	OV2640_SIZE("800x480", OV2640_800X480_WIDTH,
+		    OV2640_800X480_HEIGHT, ov2640_800x480_regs),
 	OV2640_SIZE("SVGA", SVGA_WIDTH, SVGA_HEIGHT, ov2640_svga_regs),
 	OV2640_SIZE("XGA", XGA_WIDTH, XGA_HEIGHT, ov2640_xga_regs),
 	OV2640_SIZE("SXGA", SXGA_WIDTH, SXGA_HEIGHT, ov2640_sxga_regs),
@@ -1002,11 +1041,11 @@
 	struct v4l2_mbus_framefmt *try_fmt =
 		v4l2_subdev_state_get_format(sd_state, 0);
 	const struct ov2640_win_size *win =
-		ov2640_select_win(SVGA_WIDTH, SVGA_HEIGHT);
+		ov2640_select_win(OV2640_800X480_WIDTH, OV2640_800X480_HEIGHT);
 
 	try_fmt->width = win->width;
 	try_fmt->height = win->height;
-	try_fmt->code = MEDIA_BUS_FMT_UYVY8_2X8;
+	try_fmt->code = MEDIA_BUS_FMT_RGB565_2X8_BE;
 	try_fmt->colorspace = V4L2_COLORSPACE_SRGB;
 	try_fmt->field = V4L2_FIELD_NONE;
 	try_fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
@@ -1201,6 +1240,22 @@
 		return -ENOMEM;
 
 	if (client->dev.of_node) {
+		struct clk *pl_reset_clk;
+
+		/*
+		 * This board wires the PL clock's LOCKED output to the camera
+		 * unpacker and xvclk MMCM resets. Hold it on even without HDMI.
+		 */
+		pl_reset_clk = devm_clk_get_optional_enabled(&client->dev,
+							   "pl-reset");
+		if (IS_ERR(pl_reset_clk))
+			return dev_err_probe(&client->dev, PTR_ERR(pl_reset_clk),
+					     "failed to release PL camera reset\n");
+
+		/* Allow the downstream xvclk MMCM and sensor to settle. */
+		if (pl_reset_clk)
+			usleep_range(3000, 5000);
+
 		priv->clk = devm_clk_get_enabled(&client->dev, "xvclk");
 		if (IS_ERR(priv->clk))
 			return PTR_ERR(priv->clk);
@@ -1210,8 +1265,8 @@
 	if (ret)
 		return ret;
 
-	priv->win = ov2640_select_win(SVGA_WIDTH, SVGA_HEIGHT);
-	priv->cfmt_code = MEDIA_BUS_FMT_UYVY8_2X8;
+	priv->win = ov2640_select_win(OV2640_800X480_WIDTH, OV2640_800X480_HEIGHT);
+	priv->cfmt_code = MEDIA_BUS_FMT_RGB565_2X8_BE;
 
 	v4l2_i2c_subdev_init(&priv->subdev, client, &ov2640_subdev_ops);
 	priv->subdev.internal_ops = &ov2640_internal_ops;
diff --git a/drivers/media/platform/xilinx/xilinx-vip.c b/drivers/media/platform/xilinx/xilinx-vip.c
--- a/drivers/media/platform/xilinx/xilinx-vip.c
+++ b/drivers/media/platform/xilinx/xilinx-vip.c
@@ -24,6 +24,9 @@
  */
 
 static const struct xvip_video_format xvip_video_formats[] = {
+	/* DVP bytes are unpacked and stored by the PL as little-endian RGB565. */
+	{ XVIP_VF_RBG, 8, NULL, MEDIA_BUS_FMT_RGB565_2X8_BE,
+	  2, 16, V4L2_PIX_FMT_RGB565, 1, 1, 1, 1 },
 	{ XVIP_VF_YUV_420, 8, NULL, MEDIA_BUS_FMT_VYYUYY8_1X24,
 	  1, 12, V4L2_PIX_FMT_NV12, 2, 1, 1, 2 },
 	{ XVIP_VF_YUV_420, 8, NULL, MEDIA_BUS_FMT_VYYUYY8_1X24,
diff --git a/drivers/media/platform/xilinx/xilinx-dma.c b/drivers/media/platform/xilinx/xilinx-dma.c
--- a/drivers/media/platform/xilinx/xilinx-dma.c
+++ b/drivers/media/platform/xilinx/xilinx-dma.c
@@ -28,9 +28,9 @@
 #include "xilinx-vip.h"
 #include "xilinx-vipp.h"
 
-#define XVIP_DMA_DEF_FORMAT		V4L2_PIX_FMT_YUYV
-#define XVIP_DMA_DEF_WIDTH		1920
-#define XVIP_DMA_DEF_HEIGHT		1080
+#define XVIP_DMA_DEF_FORMAT		V4L2_PIX_FMT_RGB565
+#define XVIP_DMA_DEF_WIDTH		800
+#define XVIP_DMA_DEF_HEIGHT		480
 #define XVIP_DMA_DEF_WIDTH_ALIGN	2
 /* Minimum and maximum widths are expressed in bytes */
 #define XVIP_DMA_MIN_WIDTH		1U
@@ -867,6 +867,7 @@
 		pix_mp = &format->fmt.pix_mp;
 		plane_fmt = pix_mp->plane_fmt;
 		pix_mp->field = dma->format.fmt.pix_mp.field;
+		pix_mp->num_planes = info->buffers;
 		width = rounddown(pix_mp->width * info->bpl_factor,
 				  dma->width_align);
 		pix_mp->width = clamp(width, min_width, max_width) /
@@ -1278,6 +1279,10 @@
 		pix_mp->colorspace = V4L2_COLORSPACE_SRGB;
 		pix_mp->field = V4L2_FIELD_NONE;
 		pix_mp->width = XVIP_DMA_DEF_WIDTH;
+		pix_mp->height = XVIP_DMA_DEF_HEIGHT;
+		pix_mp->num_planes = dma->fmtinfo->buffers;
+		dma->r.width = pix_mp->width;
+		dma->r.height = pix_mp->height;
 
 		/* Handling contiguous data with mplanes */
 		if (dma->fmtinfo->buffers == 1) {
@@ -1307,6 +1312,8 @@
 		pix->field = V4L2_FIELD_NONE;
 		pix->width = XVIP_DMA_DEF_WIDTH;
 		pix->height = XVIP_DMA_DEF_HEIGHT;
+		dma->r.width = pix->width;
+		dma->r.height = pix->height;
 		pix->bytesperline = pix->width * dma->fmtinfo->bpl_factor;
 		pix->sizeimage =
 			pix->width * pix->height * dma->fmtinfo->bpp / 8;
diff --git a/Documentation/devicetree/bindings/media/i2c/ov2640.txt b/Documentation/devicetree/bindings/media/i2c/ov2640.txt
--- a/Documentation/devicetree/bindings/media/i2c/ov2640.txt
+++ b/Documentation/devicetree/bindings/media/i2c/ov2640.txt
@@ -10,6 +10,11 @@
 - clock-names: should be "xvclk".
 
 Optional Properties:
+- clocks / clock-names: an additional clock named "pl-reset" may be supplied
+  on boards where the clock provider's lock signal releases the parallel
+  capture logic and xvclk generator from reset. Its rate must be configured
+  with assigned-clocks / assigned-clock-rates. The driver keeps it enabled
+  while the sensor is bound, independently of the display's clock consumer.
 - resetb-gpios: reference to the GPIO connected to the resetb pin, if any.
 - pwdn-gpios: reference to the GPIO connected to the pwdn pin, if any.
 
